---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<a href="https://www.youtube.com/watch?v=CSvFpBOe8eY" target="_blank" class="bar">
	Silakan pesan capcay di 081234567890
</a>
<style>
	.bar {
		background-color: yellow;
		text-align: center;
	}
	a {
		display: block;
		color: var(--black);
		text-decoration: none;
	}
	a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	
	.internal-links {
		font-family: var(--font-body);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
